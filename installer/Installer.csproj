<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>汉堡店修改器-安装程序</AssemblyName>
    <RootNamespace>BurgerShopInstaller</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <OutputPath>..\dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.0.1</Version>
    <Product>Four Nights at the Burger Shop 数值修改器 安装程序</Product>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Installer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 美术资源：立绘 + 图标，一起内嵌，保持单文件分发 -->
    <EmbeddedResource Include="art.png">
      <LogicalName>art.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="art.ico">
      <LogicalName>art.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 把载荷 zip 内嵌进 exe，安装程序即为单文件分发 -->
    <EmbeddedResource Include="payload.zip">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
