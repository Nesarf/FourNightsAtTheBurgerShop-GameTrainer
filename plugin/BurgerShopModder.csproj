<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>2×9+9L+6[ED]+7+2×45→1[C]+LS</AssemblyName>
    <RootNamespace>BurgerShopModder</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <OutputPath>..\dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.97</Version>
    <Product>Four Nights at the Burger Shop Numeric Modifier</Product>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <NoWarn>CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BurgerShopModder.cs" />
    <Compile Include="ActivityLogger.cs" />
    <Compile Include="GameCommandServer.cs" />
        <Compile Include="CfgGuard.cs" />
    <Compile Include="GameBindings.cs" />
    <Compile Include="PresetStore.cs" />
    <Compile Include="GameBuild.cs" />
    <Compile Include="Localization.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 英文对照表：编进 DLL，装上就能用。
         LogicalName 钉死成 lang/en.txt，免得资源名受 RootNamespace 影响
         （Localization.cs 里的 L.ResourceName 就是照这个名字找的）。 -->
    <EmbeddedResource Include="lang\en.txt">
      <LogicalName>lang/en.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 私有引用：编译需要，但不复制到输出目录（运行时由游戏提供） -->
    <Reference Include="BepInEx">
      <HintPath>..\refs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\refs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\refs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\refs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\refs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\refs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\refs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\refs\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\refs\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\refs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\refs\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
