# Reference assemblies from the game (copyrighted, not committed) — see "Building" in the README
refs/
*.dll
!dist/*.dll
!installer/art.ico

# Local config and paths
tools/gamepath.txt
cfg-snapshots/
*.cfg

# Runtime logs and analysis output
watch-archive/
src/
tex/
model/
dxt/
demosaic-audit/
.venv*/

# Build intermediates
bin/
obj/

# Throwaway scripts
_*.py
*.bak

# Scratch directory used when packing the installer
/_tmp/

# Installer build intermediate (produced by installer/make_payload.ps1; worthless once embedded in the exe)
installer/payload.zip

# static-check orphan list (rewritten on every run, never committed)
_orphan.txt
/_tmp/orphan.txt
